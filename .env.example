# Copie para .env (o install.bat faz isso) e preencha. O .env nunca vai para o GitHub.

# Ollama (padrão do instalador: 127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434

# Busca na internet e notícias: https://brave.com/search/api/ (plano grátis)
BRAVE_API_KEY=
# Previsão do tempo: https://openweathermap.org/api
OPENWEATHER_API_KEY=
# Opcionais
GOOGLE_MAPS_API_KEY=
API_KEY_GOOGLE_SPEECH=

# Token da API e do painel (o instalador gera um aleatório)
SECRET_TOKEN_JARVIS=

# Sua cidade, para o clima
JARVIS_HOME_CITY=Lexy
JARVIS_HOME_COUNTRY=FR

# Opcionais (veja o README): JARVIS_COMFYUI_DIR, JARVIS_APPS_DIR, JARVIS_CONSOLE_LEVEL=INFO, ...
